# KisanSathi Configuration File
# Copy this file to .env and fill in your values.

# General App Settings
APP_NAME=KisanSathi
APP_ENV=development
DEBUG=True
PORT=8000
HOST=0.0.0.0

# Region & Crop Scoping (v1 defaults: Maharashtra, 4 key crops)
DEFAULT_STATE=Maharashtra
DEFAULT_LANGUAGE=hi
SECONDARY_LANGUAGE=te
SUPPORTED_CROPS=tomato,onion,soybean,cotton

# RAG Configuration
CHUNKING_STRATEGY=recursive   # Options: fixed, recursive, semantic
CHUNK_SIZE=500
CHUNK_OVERLAP=80
RETRIEVAL_TOP_K=4
RETRIEVAL_CONFIDENCE_THRESHOLD=0.62   # Below this, bot escalates or says 'I do not know'
VECTOR_STORE_BACKEND=chroma          # Options: chroma, qdrant, inmemory
EMBEDDING_PROVIDER=sentence-transformers # Options: sentence-transformers, bge-m3, openai, mock

# LLM Provider Configuration (Provider-agnostic wrapper)
# Options: gemini, openai, ollama, mock
LLM_PROVIDER=mock
GEMINI_API_KEY=
OPENAI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL_NAME=gemini-1.5-flash
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=512

# Speech Services (v1 / v2)
STT_PROVIDER=whisper            # Options: whisper, mock
TTS_PROVIDER=gtts               # Options: gtts, bhashini, mock

# Weather & Market Tools
OPENWEATHER_API_KEY=
DATA_GOV_IN_API_KEY=
CACHE_TTL_SECONDS=1800

# Security & Safety
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_secret_in_prod
JWT_SECRET=super_secret_jwt_key_for_kisansathi
RATE_LIMIT_PER_MINUTE=30
ENABLE_SAFETY_GUARDRAILS=True

# Emergency & Helpline Escalation
KISAN_CALL_CENTRE_HELPLINE=1800-180-1551

# WhatsApp Cloud API Webhook Integration
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=kisansathi_verify_token
WHATSAPP_APP_SECRET=
